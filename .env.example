# Copy to .env.local for local runs. Never commit real secrets.

# Required to authorize /api/cron/publish (Vercel Cron uses the same value)
CRON_SECRET=replace-me

# AI Gateway (local). On Vercel, OIDC (VERCEL_OIDC_TOKEN) can replace this.
AI_GATEWAY_API_KEY=replace-me

# Optional model override (AI Gateway creator/model string)
# AI_MODEL=anthropic/claude-sonnet-4.5

# GitHub commit target for auto-publish (Contents/Git Data API)
GITHUB_TOKEN=replace-me-with-repo-contents-write-token
GITHUB_REPO=andrewrazaly/digitalcmo
GITHUB_CONTENT_BRANCH=main

# Write files to the local workspace instead of GitHub
# PUBLISH_DRY_RUN=1

# Canonical site URL (optional; falls back to VERCEL_URL / localhost)
# NEXT_PUBLIC_SITE_URL=https://<deployment>.vercel.app
#
# Vercel project (locked): https://vercel.com/andrewrazalys-projects/digitalcmo
